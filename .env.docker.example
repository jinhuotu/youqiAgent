# 复制为 .env.docker 后按需修改：
#   copy .env.docker.example .env.docker
#
# Windows 本机默认 DATA_ROOT=./data
# Ubuntu 服务器改为：DATA_ROOT=/opt/youqiAgent/data

# ---------- 数据目录 ----------
DATA_ROOT=./data
WEB_PORT=8091

# ---------- 国内基础镜像（可按需改成其它代理）----------
# DaoCloud 拉 blob 若 401，可改用下方 1ms 或官方 docker.io
PYTHON_IMAGE=docker.1ms.run/library/python:3.12.5-slim-bookworm
# web 构建用；api 用 NODE_VERSION + NODE_SHA256 多源下载并校验（避免截断 EOF）
NODE_IMAGE=docker.1ms.run/library/node:20-bookworm-slim
NODE_VERSION=20.18.1
NODE_SHA256=c6fa75c841cbffac851678a472f2a5bd612fff8308ef39236190e1f8dbb0e567
NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0
REDIS_IMAGE=docker.1ms.run/library/redis:7-alpine

# ---------- MySQL（compose 内网）----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=agent_ai
MYSQL_USER=admin
MYSQL_PASSWORD=change_me

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- 应用（注入 api 容器）----------
ENV=production
LOG_LEVEL=INFO
APP_VERSION=1.0.0
# 浏览器访问 http://<主机>:8091 时 Origin 须在此列表（公网 IP 请自行追加）
CORS_ORIGINS=http://localhost:8091,http://127.0.0.1:8091

# 服务间密钥（运维台连接设置里的 Service Token）
INTERNAL_SERVICE_TOKENS=change_me_service_token_1,change_me_service_token_2
ENABLE_ADMIN_ROLE=true

# Fernet 密钥：请替换为正式环境生成值
# poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=cn6cgzuflm-ppffMbtrElR11FoZzBzrnMWr_fFop0B0=

ROUND_WARN_THRESHOLD=30
SUMMARY_TRIGGER_ROUNDS=25
SUMMARY_KEEP_ROUNDS=5
SUMMARY_TOKEN_RATIO=0.8

KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
KB_DEFAULT_TOP_K=5
KB_RAG_MAX_DISTANCE=1.5
KB_NEIGHBOR_WINDOW=1
KB_RETRIEVE_CANDIDATE_MULTIPLIER=3
KB_EMBED_BATCH_SIZE=10
KB_JOB_WORKERS=1
UPLOAD_MAX_FILE_SIZE_MB=100

MCP_COMMAND_ALLOWLIST=npx,uvx,node,python,python3
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_TOOL_MAX_ROUNDS=8
MCP_TOOL_RESULT_MAX_CHARS=8000
