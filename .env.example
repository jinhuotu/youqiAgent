# ==================== 服务配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
ENV=development
APP_VERSION=1.0.0
# 前端跨域来源，多个用英文逗号分隔（必须与浏览器 Origin 完全一致，含协议和端口）
# 运维台默认 5173；业务系统本地常见 8848，请按实际前端地址增删
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8848,http://127.0.0.1:8848

# ==================== MySQL 配置 ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_DATABASE=agent_ai

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Chroma 向量库配置 ====================
CHROMA_PERSIST_PATH=./data/chroma

# ==================== 服务间鉴权配置 ====================
# 多个密钥用英文逗号分隔，Java 后端调用时在请求头 X-Service-Token 中携带其中一个
INTERNAL_SERVICE_TOKENS=your_service_secret_key1,your_service_secret_key2
# 是否启用管理员角色权限（X-Role=admin 可管理公共资源）
ENABLE_ADMIN_ROLE=true

# ==================== 加密配置 ====================
# 用于数据库中 API Key 等敏感字段的 Fernet 加密密钥（32字节 url-safe base64）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=cn6cgzuflm-ppffMbtrElR11FoZzBzrnMWr_fFop0B0=

# ==================== 会话配置 ====================
# 轮数提醒阈值
ROUND_WARN_THRESHOLD=30
# 自动总结触发轮数
SUMMARY_TRIGGER_ROUNDS=25
# 总结后保留的最近对话轮数
SUMMARY_KEEP_ROUNDS=5
# Token 占用达到上下文上限的百分比时触发总结（0.8 = 80%）
SUMMARY_TOKEN_RATIO=0.8

# ==================== 知识库 ====================
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
KB_CHUNK_PROGRESS_EVERY=10
KB_DEFAULT_TOP_K=5
KB_SOURCE_PREVIEW_CHARS=240
# 阿里云 text-embedding-v3/v4 单批上限 10
KB_EMBED_BATCH_SIZE=10
KB_JOB_WORKERS=1
KB_JOB_STUCK_MINUTES=30
UPLOAD_ROOT=./data/uploads
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_FILES_PER_REQUEST=10

# ==================== MCP ====================
# stdio 子进程工作目录（filesystem 类 server 建议限制在此目录）
MCP_WORKDIR=./data/mcp
# 允许的命令 basename 白名单
MCP_COMMAND_ALLOWLIST=npx,uvx,node,python,python3
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_TOOL_MAX_ROUNDS=8
MCP_TOOL_RESULT_MAX_CHARS=8000
